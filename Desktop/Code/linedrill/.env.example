# ─── LineDrill Environment Variables ───────────────────────────
#
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to version control.

# Anthropic API key (for script parsing)
# Get one at https://console.anthropic.com/
NEXT_PUBLIC_ANTHROPIC_API_KEY=

# ─── Phase 2 (future) ─────────────────────────────────────────
# Deepgram API key (speech-to-text)
# NEXT_PUBLIC_DEEPGRAM_API_KEY=

# ElevenLabs API key (text-to-speech with multiple voices)
# NEXT_PUBLIC_ELEVENLABS_API_KEY=
