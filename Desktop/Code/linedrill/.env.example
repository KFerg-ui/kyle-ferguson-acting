# ─── LineDrill Environment Variables ───────────────────────────
#
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to version control.

# Anthropic API key (server-side, used by /api/parse route)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Deepgram API key (server-side, used for speech-to-text)
# Optional — without it, falls back to browser Web Speech API (Chrome/Edge only)
# Get one at https://console.deepgram.com/
DEEPGRAM_API_KEY=
